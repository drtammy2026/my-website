---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { generalFaqs } from '../data/faqs';
import { PAGE_READY } from '../data/site';

const serviceFaqLinks = [
  { href: '/services/restore-within', label: 'Restore Within', ready: true },
  { href: '/services/lead-unbound', label: 'Lead Unbound', ready: true },
  { href: '/services/relationship-coaching', label: 'Relationship Coaching', ready: PAGE_READY.relationship },
  { href: '/services/foster-adoptive-families', label: 'Foster and Adoptive Families', ready: PAGE_READY.family },
  { href: '/speaking', label: 'Speaking & Training', ready: PAGE_READY.speaking },
].filter((s) => s.ready);
---
<Base title="FAQ" description="Answers to common questions about coaching with Dr. Tammy Young: therapy vs. coaching, faith, sessions, confidentiality, and more.">
  <PageHeader eyebrow="Frequently Asked Questions">
    <h1>You probably have <em>questions.</em></h1>
    <p class="lede">That's a good sign. It means you're taking this seriously. Here are the ones I hear most often.</p>
  </PageHeader>

  <section class="section white">
    <div class="section-inner">
      <Faq items={generalFaqs} idPrefix="general" />

      <div class="section-intro" style="margin-top:5rem; margin-bottom:1.5rem">
        <h2 class="section-heading small">Questions about a specific service?</h2>
        <p>Each service page has its own questions and answers.</p>
      </div>
      <div class="actions center">
        {serviceFaqLinks.map((s) => <a class="btn-outline-sage" href={s.href}>{s.label}</a>)}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Still have a question?"
    text="Send it our way, and Dr. Tammy's team will get back to you within 48 hours."
    label="Ask Dr. Tammy"
  />
</Base>
