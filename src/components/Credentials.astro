---
interface Props {
  title?: string;
}
const { title = 'Credentials & Training' } = Astro.props;
const titleId = 'credentials-title-' + Math.random().toString(36).slice(2, 7);
---
<div class="credentials" aria-labelledby={titleId}>
  <p class="credentials-title" id={titleId}>{title}</p>
  <ul class="credentials-list">
    <li><span class="cred-name">Doctor of Ministry (D.Min.)</span><span class="cred-detail">Trauma Transformation · Southeastern University</span></li>
    <li><span class="cred-name">Master of Arts (M.A.), Christian Ministries</span><span class="cred-detail">Emphasis on Women in Leadership · AGTS, Evangel University</span></li>
    <li><span class="cred-name">Professional Certified Coach (PCC)</span><span class="cred-detail">International Coaching Federation</span></li>
    <li><span class="cred-name">NLP &amp; RVT Certified</span><span class="cred-detail">Neuro-Linguistic Programming and Renewed Vision Technique</span></li>
    <li><span class="cred-name">Ordained Minister</span><span class="cred-detail">Ordained since 2002</span></li>
  </ul>
</div>
